{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Project",
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/nologo",
                "/I${workspaceFolder}\\include",
                "/Fe${workspaceFolder}\\main.exe",
                "${workspaceFolder}\\src\\main.cpp",
                "${workspaceFolder}\\src\\test.cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "detail": "Build the C++ project before running it."
        },
        {
            "label": "Build and Run",
            "dependsOn": [
                "Build Project"
            ],
            "dependsOrder": "sequence",
            "type": "shell",
            "command": "& \"${workspaceFolder}\\main.exe\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "detail": "Build the project and execute the resulting binary."
        }
    ]
}